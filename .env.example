# ============================================================================
# L'Étoile de l'Est — Environment Configuration
# Copy this file to .env.local and fill in the values.
# When values are absent, the app falls back to mock data so dev still works.
# ============================================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (EU-West region recommended) ----
# Create a project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Phone OTP (Supabase Auth → Twilio) ----
# Configured in Supabase Dashboard → Authentication → Providers → Phone
# These are set inside Supabase, not here. Listed for reference:
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_MESSAGING_SERVICE_SID

# ---- Payments ----
# BaridiMob (Algérie Poste) — primary. Manual confirmation flow in V1.
BARIDIMOB_CCP_ACCOUNT=
BARIDIMOB_CCP_KEY=
BARIDIMOB_RIB=
BARIDIMOB_WEBHOOK_SECRET=

# CIB (GIE Monétique / SATIM) — secondary
CIB_MERCHANT_ID=
CIB_API_KEY=
CIB_WEBHOOK_SECRET=
CIB_GATEWAY_URL=https://test.satim.dz/payment/rest

# ---- Notifications ----
# Firebase Cloud Messaging — web push (Android primary, iOS 16.4+)
NEXT_PUBLIC_FCM_API_KEY=
NEXT_PUBLIC_FCM_AUTH_DOMAIN=
NEXT_PUBLIC_FCM_PROJECT_ID=
NEXT_PUBLIC_FCM_SENDER_ID=
NEXT_PUBLIC_FCM_APP_ID=
NEXT_PUBLIC_FCM_VAPID_KEY=
FCM_SERVER_KEY=

# WhatsApp Business via 360dialog (server-side, for automated confirmations)
WHATSAPP_360DIALOG_API_KEY=
WHATSAPP_360DIALOG_PHONE=

# WhatsApp Booking — public numbers used by the wa.me deep-link booking page.
# Format: digits only (no + or spaces). Algeria country code is 213.
# Found in the Étoile de l'Est Instagram bio + the Sunset Pool bio.
NEXT_PUBLIC_WHATSAPP_BOOKING=213555000000
NEXT_PUBLIC_WHATSAPP_POOL=213555000000

# ---- Analytics ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# ---- Admin bootstrap ----
# Comma-separated +213 phone numbers that get role = 'admin' on first login
ADMIN_PHONE_ALLOWLIST=
