# ============================================================================
# Oxygen Island DZ — Environment Configuration
# Copy to .env.local. Mock mode runs without any of these set.
# ============================================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (EU-West recommended for Algeria latency) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp deep-link reservation numbers (digits only) ----
# Real numbers found on Oxygen Island public listings:
#   +213 660 05 65 83 / +213 560 34 34 22 / +213 560 71 09 27
# Confirm with the owner which number is for reservations vs general info.
NEXT_PUBLIC_WHATSAPP_BOOKING=213660056583
NEXT_PUBLIC_WHATSAPP_INFO=213560343422

# ---- Payments (Algerian gateways — no Stripe/PayPal) ----
BARIDIMOB_CCP_ACCOUNT=
BARIDIMOB_RIB=
BARIDIMOB_WEBHOOK_SECRET=
CIB_MERCHANT_ID=
CIB_API_KEY=
CIB_WEBHOOK_SECRET=
CIB_GATEWAY_URL=https://test.satim.dz/payment/rest

# ---- Analytics ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
